msgstr "Datos"

msgid "Simulated data from parallel analysis"
msgstr "Datos simulados de análises paralelas"

msgid ""
"Input data does not seem to be a square matrix! Please check the format of "
"the input data."
msgstr ""
"Os datos introducidos non semellan ser unha matriz cadrada! Por favor, "
"comproba o formato dos datos introducidos."

msgid ""
"Input data does not seem to be a symmetric matrix! Please check the format "
"of the input data and possibly the order of the variables."
msgstr ""
"Os datos introducidos non semellan ser unha matriz simétrica! Por favor, "
"comproba o formato dos datos introducidos e posiblemente a orde das "
"variables."

msgid "All cells must be numeric."
msgstr "Tódalas celas deben ser numéricas."

msgid "Too many %1$s requested (%2$i) for the amount of included variables"
msgstr "Requírense %1$s de máis (%2$i) para a cantidade de variables incluídas"

msgid "Not enough valid cases (%i) to run this analysis"
msgstr "Non hai casos válidos (%i) abondo para executar esta análise"

msgid "Data not valid: variance is zero in each row"
msgstr "Datos incorrectos: varianza nula en cada fila"

msgid "Data not valid: there are more variables than observations"
msgstr "Datos incorrectos: hai máis variables que observacións"

msgid "Data not valid: too many missing values in variable(s) %s."
msgstr "Datos incorrectos: demasiados valores ausentes na(s) variable(s) %s."

msgid "Data not valid: all variables are collinear"
msgstr "Datos incorrectos: todas as variables son colineares"

msgid "Component Loadings"
msgstr "Cargas de Compoñentes"

msgid "Applied rotation method is %s."
msgstr "O método de rotación que se aplicou é %s."

msgid "Component Characteristics"
msgstr "Características das Compoñentes"

msgid "Component Correlations"
msgstr "Correlacións das Compoñentes"


msgstr "Pemuatan Faktor (Matriks Struktur)"

msgid "Factor Characteristics"
msgstr "Karakteristik Faktor"

msgid "Unrotated solution"
msgstr "Solusi tidak berotasi"

msgid "Rotated solution"
msgstr "Solusi berotasi"

msgid "Eigenvalue"
msgstr "Nilai Eigen"


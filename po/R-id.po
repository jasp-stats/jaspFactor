msgid "Data"
msgstr "Data"

msgid "Simulated data from parallel analysis"
msgstr "Data tersimulasi dari analisis paralel"

msgid ""
"Input data does not seem to be a square matrix! Please check the format of "
"the input data."
msgstr ""
"Data masukan terlihatnya tidak matriks kuadrat! Silakan periksa format dari "
"data masukan."

msgid ""
"Input data does not seem to be a symmetric matrix! Please check the format "
"of the input data and possibly the order of the variables."
msgstr ""
"Data masukan terlihatnya tidak matriks simetris! Silakan periksa format dari "
"data masukan dan secara memungkinkan urutan dari variabel."

msgid "All cells must be numeric."
msgstr "Semua sel harus numerik."

msgid "Too many %1$s requested (%2$i) for the amount of included variables"
